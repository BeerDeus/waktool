# HTML/JS/CSS/données : toujours revalider (les URLs sont versionnées via ?v=)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|gz|wasm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
# fichiers internes du dépôt
<FilesMatch "^(\.firebaserc|firebase\.json|firestore\.rules|README\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(scripts|\.github|\.git)(/|$)
